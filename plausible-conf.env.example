# Copy to plausible-conf.env and fill in the values.

# Public URL of your instance, e.g. https://plausible.example.com
BASE_URL=replace-me
# openssl rand -base64 48
SECRET_KEY_BASE=replace-me

# Databases (defaults match the docker-compose service names)
DATABASE_URL=postgres://postgres:postgres@plausible_db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

# Outgoing mail through the bundled `mail` SMTP relay container
MAILER_EMAIL=plausible@example.com
SMTP_HOST_ADDR=mail
SMTP_HOST_PORT=25
SMTP_HOST_SSL_ENABLED=false

# --- Persistent visitor tracking (this fork) ---
# false (default) = upstream behaviour: visitor ids use a daily rotating salt.
# true            = stable visitor ids, so unique visitors deduplicate across days.
ENABLE_PERSISTENT_TRACKING=true
# Required when ENABLE_PERSISTENT_TRACKING=true, at least 16 bytes.
# Generate with: openssl rand -base64 48
# Keep it stable: changing it makes every visitor look new.
PERSISTENT_SALT_SECRET=replace-me
# Custom property that carries the client-side device id (default: deviceId).
# PERSISTENT_TRACKING_DEVICE_ID_PROP=deviceId
